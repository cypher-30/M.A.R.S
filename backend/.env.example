# Copy to .env and fill in. Never commit the filled-in file.

ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=http://localhost:3000
SCHEDULER_PAUSED=true
DATABASE_URL=postgresql+psycopg://mars:MARS@localhost:5432/mars

# Market data
MYSTOCKS_API_KEY=
MYSTOCKS_BASE_URL=https://api.mystocks.co.ke
ETF_TICKER=WSA
CONSTITUENT_TICKERS=KCB,EQTY,COOP,ABSA,SCBK,NCBA,SBIC,IMH

# Macro data sources
CBK_RATES_URL=https://www.centralbank.go.ke
KNBS_CPI_URL=https://www.knbs.or.ke
# Leave true unless you've confirmed a KNBS fetch failure is their known
# broken certificate chain ("unable to get local issuer certificate") and
# accept the risk for this read-only public-data fetch. See config.py.
KNBS_VERIFY_TLS=true

# Document parser — set LLM_PROVIDER to openai or gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Alerting
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Trading economics
BROKERAGE_EXIT_FEE_PCT=2.1
EXIT_FEE_SAFETY_BUFFER_PCT=0.5
